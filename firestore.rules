rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // FUNCIONES AUXILIARES DE IDENTIDAD Y CONTROL DE ACCESO (MEDUSA ALFHA)
    // =========================================================================

    // Verifica que la solicitud provenga de un usuario autenticado
    function isAuthenticated() {
      return request.auth != null;
    }

    // Superadministrador / Comando Central ALFHA
    function isMaestroAlfa() {
      return isAuthenticated() && (
        request.auth.token.email in ['alfhaseguridad070@gmail.com', 'carlos.mendoza@alfhaseguridad.com'] ||
        request.auth.token.admin == true ||
        request.auth.token.role == 'MAESTRO_ALFHA'
      );
    }

    // Obtiene el documento oficial del usuario en el condominio
    function getUserDoc(condominiumId) {
      return get(/databases/$(database)/documents/condominiums/$(condominiumId)/users/$(request.auth.uid)).data;
    }

    // Verifica si el usuario tiene documento registrado en la colección oficial de usuarios
    function hasUserDoc(condominiumId) {
      return exists(/databases/$(database)/documents/condominiums/$(condominiumId)/users/$(request.auth.uid));
    }

    // Obtiene el rol oficial del usuario (Primero Custom Claims del token, luego documento /users)
    function getUserRole(condominiumId) {
      return request.auth.token.role != null ? request.auth.token.role :
        (hasUserDoc(condominiumId) ? getUserDoc(condominiumId).role : null);
    }

    // Obtiene la vivienda asignada oficial del usuario
    function getUserUnit(condominiumId) {
      return request.auth.token.unitId != null ? request.auth.token.unitId :
        (request.auth.token.authorizedUnitNumber != null ? request.auth.token.authorizedUnitNumber :
          (hasUserDoc(condominiumId) ? getUserDoc(condominiumId).authorizedUnitNumber : null));
    }

    // Pertenencia validada al condominio
    function isAssignedToCondominium(condominiumId) {
      return isMaestroAlfa() || (
        isAuthenticated() && (
          request.auth.token.condominiumId == condominiumId ||
          (hasUserDoc(condominiumId) && getUserDoc(condominiumId).condominiumId == condominiumId)
        )
      );
    }

    // Roles Operativos y Administrativos
    function isMesaDirectiva(condominiumId) {
      return isMaestroAlfa() || (
        isAssignedToCondominium(condominiumId) &&
        getUserRole(condominiumId) in ['MESA_DIRECTIVA', 'DIRECTOR', 'PRESIDENCIA']
      );
    }

    function isAdministrador(condominiumId) {
      return isMaestroAlfa() || isMesaDirectiva(condominiumId) || (
        isAssignedToCondominium(condominiumId) &&
        getUserRole(condominiumId) in ['ADMINISTRACION', 'ADMINISTRADOR']
      );
    }

    function isSupervisor(condominiumId) {
      return isAdministrador(condominiumId) || (
        isAssignedToCondominium(condominiumId) &&
        getUserRole(condominiumId) in ['SUPERVISOR', 'COMANDANTE']
      );
    }

    function isGuardia(condominiumId) {
      return isSupervisor(condominiumId) || (
        isAssignedToCondominium(condominiumId) &&
        getUserRole(condominiumId) in ['GUARDIA', 'SECURITY_GUARD', 'CASETA']
      );
    }

    function isResidente(condominiumId) {
      return isAssignedToCondominium(condominiumId) &&
        getUserRole(condominiumId) in ['RESIDENTE', 'PROPIETARIO', 'ARRENDATARIO'];
    }

    // Comprobación de titularidad de vivienda (Garantiza que Casa 54 no vea Casa 53, Casa 55, etc.)
    function isOwnerOfUnit(condominiumId, targetUnit) {
      return isResidente(condominiumId) && (
        getUserUnit(condominiumId) == targetUnit ||
        (getUserUnit(condominiumId) != null && targetUnit != null &&
         (getUserUnit(condominiumId).matches('.*' + targetUnit + '.*') || targetUnit.matches('.*' + getUserUnit(condominiumId) + '.*')))
      );
    }

    // Validaciones de integridad en creación y actualización
    function isValidCreate(condominiumId) {
      return request.resource.data.condominiumId == condominiumId;
    }

    function isValidUpdate(condominiumId) {
      return request.resource.data.condominiumId == condominiumId &&
             resource.data.condominiumId == condominiumId &&
             request.resource.data.condominiumId == resource.data.condominiumId;
    }

    // =========================================================================
    // COLECCIONES GLOBALES / RAÍZ
    // =========================================================================

    // Llaves de Activación (Solo lectura para autenticados al activar, escritura solo Maestro Alfa)
    match /activation_keys/{keyId} {
      allow read: if isAuthenticated();
      allow write: if isMaestroAlfa();
    }

    // =========================================================================
    // PARTICIÓN MULTI-INQUILINO: /condominiums/{condominiumId}
    // =========================================================================
    match /condominiums/{condominiumId} {
      // Metadatos generales del condominio (ej. Los Prados Residencial, 261 casas)
      allow read: if isAssignedToCondominium(condominiumId);
      allow write: if isAdministrador(condominiumId);

      // 1. FUENTE OFICIAL DE IDENTIDADES Y ROLES: /users/{userId}
      // Principio de menor privilegio: Los residentes SOLO pueden leer su propio documento.
      match /users/{userId} {
        allow read: if isAdministrador(condominiumId) || (isAuthenticated() && request.auth.uid == userId);
        allow write: if isAdministrador(condominiumId);
      }

      // 2. PERFILES PÚBLICOS DE USUARIO: /user_profiles/{userId}
      match /user_profiles/{userId} {
        allow read: if isGuardia(condominiumId) || isAdministrador(condominiumId) || (isAuthenticated() && request.auth.uid == userId);
        allow create, update: if isAdministrador(condominiumId) || (
          isAuthenticated() && request.auth.uid == userId &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.condominiumId == condominiumId
        );
        allow delete: if isAdministrador(condominiumId);
      }

      // 3. DIRECTORIO DE RESIDENTES 360: /residents/{residentId}
      // BLINDAJE ESTRICTO: Un residente de Casa 54 NO puede consultar datos de Casa 53, Casa 55 ni de otras casas.
      match /residents/{residentId} {
        allow read: if isGuardia(condominiumId) || (
          isResidente(condominiumId) && (
            resource.data.userId == request.auth.uid ||
            resource.data.email == request.auth.token.email ||
            isOwnerOfUnit(condominiumId, resource.data.unitId)
          )
        );
        allow create, update: if isAdministrador(condominiumId);
        allow delete: if isAdministrador(condominiumId);
      }

      // 4. CATÁLOGO DE VIVIENDAS (261 Lotes Reales de Los Prados): /units/{unitId}
      match /units/{unitId} {
        allow read: if isGuardia(condominiumId) || (
          isResidente(condominiumId) && isOwnerOfUnit(condominiumId, unitId)
        );
        allow write: if isAdministrador(condominiumId);

        // Subcolección de tokens FCM asociados a la unidad
        match /fcm_tokens/{tokenId} {
          allow read, write: if isGuardia(condominiumId) || isOwnerOfUnit(condominiumId, unitId);
        }
      }

      // 5. PASES QR Y AUTORIZACIONES DE RESIDENTES: /qr_passes/{passCode}
      // Un residente solo crea y consulta sus propios pases QR.
      match /qr_passes/{passCode} {
        allow read: if isGuardia(condominiumId) || (
          isResidente(condominiumId) && (
            resource.data.createdById == request.auth.uid ||
            resource.data.residentEmail == request.auth.token.email ||
            isOwnerOfUnit(condominiumId, resource.data.destinationHouse)
          )
        );
        allow create: if isGuardia(condominiumId) || (
          isResidente(condominiumId) && isValidCreate(condominiumId) && (
            request.resource.data.createdById == request.auth.uid ||
            isOwnerOfUnit(condominiumId, request.resource.data.destinationHouse)
          )
        );
        allow update: if isGuardia(condominiumId) || (
          isResidente(condominiumId) && isValidUpdate(condominiumId) &&
          resource.data.createdById == request.auth.uid
        );
        allow delete: if isAdministrador(condominiumId);
      }

      // 6. CONTROL DE ACCESOS Y BITÁCORA DE VISITANTES: /visitor_logs/{folio} y /visitor_access/{folio}
      match /visitor_logs/{folio} {
        allow read: if isGuardia(condominiumId) || (
          isResidente(condominiumId) && (
            isOwnerOfUnit(condominiumId, resource.data.destinationUnit) ||
            isOwnerOfUnit(condominiumId, resource.data.houseNumber)
          )
        );
        allow create: if isGuardia(condominiumId) && isValidCreate(condominiumId);
        allow update: if isGuardia(condominiumId) && isValidUpdate(condominiumId);
        allow delete: if isMaestroAlfa();
      }

      match /visitor_access/{folio} {
        allow read: if isGuardia(condominiumId) || (
          isResidente(condominiumId) && (
            isOwnerOfUnit(condominiumId, resource.data.destinationUnit) ||
            isOwnerOfUnit(condominiumId, resource.data.houseNumber)
          )
        );
        allow create: if isGuardia(condominiumId) && isValidCreate(condominiumId);
        allow update: if isGuardia(condominiumId) && isValidUpdate(condominiumId);
        allow delete: if isMaestroAlfa();
      }

      // 7. INCIDENCIAS Y BITÁCORA TÁCTICA: /incidents/{folio}
      match /incidents/{folio} {
        allow read: if isGuardia(condominiumId) || (
          isResidente(condominiumId) && (
            resource.data.reportedByUserId == request.auth.uid ||
            isOwnerOfUnit(condominiumId, resource.data.reportedByUnit)
          )
        );
        allow create: if isAssignedToCondominium(condominiumId) && isValidCreate(condominiumId);
        allow update: if isSupervisor(condominiumId) && isValidUpdate(condominiumId);
        allow delete: if isMaestroAlfa();
      }

      // 8. RECEPCIÓN Y CASILLERO DE PAQUETERÍA: /packages/{packageId}
      match /packages/{packageId} {
        allow read: if isGuardia(condominiumId) || (
          isResidente(condominiumId) && (
            isOwnerOfUnit(condominiumId, resource.data.unitId) ||
            isOwnerOfUnit(condominiumId, resource.data.unitNumber)
          )
        );
        allow create: if isGuardia(condominiumId) && isValidCreate(condominiumId);
        allow update: if isGuardia(condominiumId) && isValidUpdate(condominiumId);
        allow delete: if isAdministrador(condominiumId);
      }

      // 9. PADRÓN VEHICULAR Y TAGS: /vehicles/{plate}
      match /vehicles/{plate} {
        allow read: if isGuardia(condominiumId) || (
          isResidente(condominiumId) && isOwnerOfUnit(condominiumId, resource.data.unitNumber)
        );
        allow write: if isAdministrador(condominiumId);
      }

      // 10. RONDINES Y PUNTOS DE CONTROL NFC/GPS: /patrol_logs/{logId}
      // Los residentes NO tienen acceso a la operativa interna de rondines.
      match /patrol_logs/{logId} {
        allow read: if isSupervisor(condominiumId);
        allow create: if isGuardia(condominiumId) && isValidCreate(condominiumId);
        allow update, delete: if false; // Inmutabilidad forense
      }

      // 11. RELEVO DE TURNO DE GUARDIA: /shift_handover/{shiftId}
      match /shift_handover/{shiftId} {
        allow read: if isGuardia(condominiumId);
        allow create: if isGuardia(condominiumId) && isValidCreate(condominiumId);
        allow update, delete: if false; // Inmutabilidad forense
      }

      // 12. COMUNICADOS Y AVISOS OFICIALES: /announcements/{announcementId}
      match /announcements/{announcementId} {
        allow read: if isAssignedToCondominium(condominiumId);
        allow write: if isAdministrador(condominiumId);
      }

      // 13. RESERVACIÓN DE AMENIDADES: /amenity_bookings/{bookingId}
      match /amenity_bookings/{bookingId} {
        allow read: if isAssignedToCondominium(condominiumId);
        allow create: if isAssignedToCondominium(condominiumId) && isValidCreate(condominiumId);
        allow update: if isAdministrador(condominiumId) || (
          isResidente(condominiumId) && resource.data.reservedByUserId == request.auth.uid
        );
        allow delete: if isAdministrador(condominiumId);
      }

      // 14. TICKETS DE MANTENIMIENTO: /maintenance_tickets/{ticketId}
      match /maintenance_tickets/{ticketId} {
        allow read: if isSupervisor(condominiumId) || (
          isResidente(condominiumId) && (
            resource.data.requestedByUserId == request.auth.uid ||
            isOwnerOfUnit(condominiumId, resource.data.unitNumber)
          )
        );
        allow create: if isAssignedToCondominium(condominiumId) && isValidCreate(condominiumId);
        allow update: if isSupervisor(condominiumId) && isValidUpdate(condominiumId);
        allow delete: if isAdministrador(condominiumId);
      }

      // 15. ALERTAS DE PÁNICO Y EMERGENCIAS: /panic_alerts/{alertId} y /emergency_alerts/{alertId}
      match /panic_alerts/{alertId} {
        allow read: if isGuardia(condominiumId) || (
          isResidente(condominiumId) && resource.data.userId == request.auth.uid
        );
        allow create: if isAssignedToCondominium(condominiumId) && isValidCreate(condominiumId);
        allow update, delete: if false; // Evidencia inmutable
      }

      match /emergency_alerts/{alertId} {
        allow read: if isGuardia(condominiumId) || (
          isResidente(condominiumId) && resource.data.userId == request.auth.uid
        );
        allow create: if isAssignedToCondominium(condominiumId) && isValidCreate(condominiumId);
        allow update, delete: if false;
      }

      match /security_alerts/{alertId} {
        allow read: if isGuardia(condominiumId);
        allow create: if isGuardia(condominiumId) && isValidCreate(condominiumId);
        allow update, delete: if false;
      }

      // 16. SUPERVISIÓN Y CHECKLISTS DE CAMPO: /field_validations/{validationId}
      match /field_validations/{validationId} {
        allow read: if isSupervisor(condominiumId);
        allow create: if isSupervisor(condominiumId) && isValidCreate(condominiumId);
        allow update, delete: if false;
      }

      // 17. BITÁCORA DE AUDITORÍA CRIPTOGRÁFICA: /audit_logs/{auditId}
      // EXCLUSIVO MAESTRO / ADMINISTRACIÓN. Residentes y guardias NO tienen acceso a auditoría interna.
      match /audit_logs/{auditId} {
        allow read: if isAdministrador(condominiumId);
        allow create: if isAssignedToCondominium(condominiumId) && isValidCreate(condominiumId);
        allow update, delete: if false; // Inmutabilidad forense estricta
      }

      // 18. NOTIFICACIONES Y FCM: /fcm_device_tokens, /fcm_outbox, /resident_notifications
      match /fcm_device_tokens/{tokenId} {
        allow read, write: if isAuthenticated() && (
          request.auth.uid == tokenId ||
          isAdministrador(condominiumId)
        );
      }

      match /resident_notifications/{notificationId} {
        allow read: if isGuardia(condominiumId) || (
          isResidente(condominiumId) && (
            resource.data.userId == request.auth.uid ||
            isOwnerOfUnit(condominiumId, resource.data.unitId)
          )
        );
        allow create: if isGuardia(condominiumId) && isValidCreate(condominiumId);
        allow update, delete: if isAdministrador(condominiumId);
      }

      match /fcm_outbox/{outboxId} {
        allow read, write: if isGuardia(condominiumId);
      }

      // 19. DIAGNÓSTICOS DEL SISTEMA: /system_diagnostics/{docId}
      match /system_diagnostics/{docId} {
        allow read, write: if isAdministrador(condominiumId);
      }

      // 20. AUTORIZACIONES DE ACCESO: /access_authorizations/{authId}
      match /access_authorizations/{authId} {
        allow read: if isGuardia(condominiumId) || (
          isResidente(condominiumId) && (
            resource.data.residentId == request.auth.uid ||
            isOwnerOfUnit(condominiumId, resource.data.unitId)
          )
        );
        allow create: if isResidente(condominiumId) && isValidCreate(condominiumId);
        allow update: if isGuardia(condominiumId) || (
          isResidente(condominiumId) && resource.data.residentId == request.auth.uid
        );
        allow delete: if isAdministrador(condominiumId);
      }
    }

    // =========================================================================
    // CONSULTAS POR GRUPO DE COLECCIONES (Collection Group Queries)
    // Garantizan filtro inmutable y aislamiento estricto por condominiumId
    // =========================================================================
    match /{path=**}/incidents/{incident} {
      allow read: if isMaestroAlfa() || (
        isAuthenticated() &&
        resource.data.condominiumId == request.auth.token.condominiumId &&
        request.auth.token.role in ['ADMINISTRACION', 'SUPERVISOR', 'GUARDIA']
      );
    }

    match /{path=**}/visitor_logs/{access} {
      allow read: if isMaestroAlfa() || (
        isAuthenticated() &&
        resource.data.condominiumId == request.auth.token.condominiumId &&
        request.auth.token.role in ['ADMINISTRACION', 'SUPERVISOR', 'GUARDIA']
      );
    }

    match /{path=**}/qr_passes/{pass} {
      allow read: if isMaestroAlfa() || (
        isAuthenticated() &&
        resource.data.condominiumId == request.auth.token.condominiumId &&
        request.auth.token.role in ['ADMINISTRACION', 'SUPERVISOR', 'GUARDIA']
      );
    }

    match /{path=**}/audit_logs/{log} {
      allow read: if isMaestroAlfa() || (
        isAuthenticated() &&
        resource.data.condominiumId == request.auth.token.condominiumId &&
        request.auth.token.role in ['ADMINISTRACION', 'MAESTRO_ALFHA']
      );
    }
  }
}
